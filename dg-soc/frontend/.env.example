# Copy to .env.local for development. Never commit .env.local.

# Backend base URL (M3). Loopback only.
VITE_API_BASE=http://127.0.0.1:8000

# 1 = run the whole UI off contracts/examples/events_p3.json with no backend.
# MUST be absent or 0 on the demo path (AGENTS.md section 9).
# When on, every screen shows a loud FIXTURES chip in the topbar.
# A normal build leaves the mock backend and its demo events out entirely.
VITE_USE_FIXTURES=0

# Sign-in (Supabase Auth: Google plus email and password). Names only here.
# Both empty = sign-in is not configured and the login page says so.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only while the two values above are empty: 1 = a single "Enter the console"
# sign-in on this lab machine, so the console works before auth exists.
VITE_AUTH_LOCAL=0
