{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dg-soc/event.schema.json",
  "title": "Ingest event (adapter -> backend)",
  "description": "One normalised honeypot sensor record. POST /api/ingest/events takes {\"events\": [ ... ]}, max 100 per request. Backend adds event_id and ingested_at. schema_version selects the rules: \"1.0\" events are checked exactly as contracts/history/event.schema.v1.0.json did, \"1.1\" exactly as contracts/history/event.schema.v1.1.json did, and every new rule applies only to \"1.2\" events. Only 1.2 may name db-decoy-01, file-decoy-01, db_request or file_operation. Gateway and normal-app records are not events: see contracts/telemetry.schema.json. See contracts/API.md 'Evidence boundaries (v1.1)' and 'Four honeypots, gateway and telemetry (v1.2)'.",
  "type": "object",
  "required": ["schema_version", "source_record_id", "sensor_id", "event_type", "occurred_at", "src_ip", "lab_run_id", "capture_mode"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
    "source_record_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Stable per sensor record. Cowrie: sha256 of the raw JSON line. Web: request uuid. Dedup key is (ingest namespace, sensor_id, source_record_id); the namespace is 'live' for live events and 'replay:<lab_run_id>' for replay events."
    },
    "origin_record_id": {
      "type": ["string", "null"],
      "maxLength": 128,
      "description": "1.1 only. Replay: source_record_id of the original captured record this replay copies. Must be null or absent on live events."
    },
    "sensor_id": {
      "enum": [
        "ssh-decoy-01",
        "web-decoy-01",
        "db-decoy-01",
        "file-decoy-01"
      ],
      "description": "Honeypot identity (contracts/sources.json). db-decoy-01 (MySQL authentication deception) and file-decoy-01 (SMB/file service) need schema_version 1.2. The gateway and the normal demo app are never sensors here."
    },
    "event_type": {
      "enum": [
        "connection_open",
        "auth_failure",
        "auth_success",
        "command_input",
        "connection_close",
        "http_request",
        "synthetic_file_access",
        "blocked_request",
        "bait_served",
        "db_request",
        "file_operation"
      ],
      "description": "bait_served is 1.1+ only: the sensor's own result record shows it returned content containing honeytokens. db_request and file_operation are 1.2 only and belong to db-decoy-01 and file-decoy-01 respectively."
    },
    "occurred_at": { "type": "string", "format": "date-time", "description": "UTC, from the sensor log" },
    "src_ip": { "type": "string", "format": "ipv4" },
    "src_port": { "type": ["integer", "null"] },
    "session_id": {
      "type": ["string", "null"],
      "description": "Sensor session reference. Cowrie: its session id. Web (1.1): a non-reusable reference derived by the decoy (for example a keyed digest of the session cookie with a per-run key), never the bearer cookie itself; null when the decoy has no session. MySQL (1.2): the decoy's connection id. SMB (1.2): a reference derived from the SMB session id, never a session key or ticket."
    },
    "lab_run_id": {
      "type": "string",
      "description": "Set once per run. A run has exactly one capture_mode: the first accepted event fixes it, and events with the other mode for that run are rejected. Use a 'replay-' prefix for replay runs by convention."
    },
    "capture_mode": { "enum": ["live", "replay"] },
    "attributes": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "origin_record_id": false,
          "sensor_id": { "enum": ["ssh-decoy-01", "web-decoy-01"] },
          "event_type": { "not": { "enum": ["bait_served", "db_request", "file_operation"] } },
          "attributes": { "$ref": "#/$defs/attributes_v1_0" }
        }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": "1.1" } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "source_record_id": { "minLength": 1 },
          "src_port": { "minimum": 0, "maximum": 65535 },
          "session_id": { "maxLength": 128 },
          "lab_run_id": { "minLength": 1, "maxLength": 128 },
          "sensor_id": { "enum": ["ssh-decoy-01", "web-decoy-01"] },
          "event_type": { "not": { "enum": ["db_request", "file_operation"] } },
          "attributes": { "$ref": "#/$defs/attributes_v1_1" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "source_record_id": {
            "minLength": 1
          },
          "src_port": {
            "minimum": 0,
            "maximum": 65535
          },
          "session_id": {
            "maxLength": 128
          },
          "lab_run_id": {
            "minLength": 1,
            "maxLength": 128
          },
          "attributes": {
            "$ref": "#/$defs/attributes_v1_2"
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "bait_served" } }, "required": ["event_type"] },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "required": ["asset_id", "honeytoken_ids", "issuance_id", "evidence_basis"],
            "properties": { "evidence_role": { "const": "bait" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "capture_mode": { "const": "live" } }, "required": ["capture_mode"] },
      "then": { "properties": { "origin_record_id": { "type": "null" } } }
    }
,
    {
      "if": {
        "properties": {
          "sensor_id": {
            "const": "db-decoy-01"
          }
        },
        "required": [
          "sensor_id"
        ]
      },
      "then": {
        "required": [
          "attributes"
        ],
        "properties": {
          "event_type": {
            "enum": [
              "connection_open",
              "auth_failure",
              "auth_success",
              "db_request",
              "connection_close"
            ]
          },
          "attributes": {
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "const": "mysql"
              },
              "password_sha256": false,
              "ingress": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sensor_id": {
            "const": "file-decoy-01"
          }
        },
        "required": [
          "sensor_id"
        ]
      },
      "then": {
        "required": [
          "attributes"
        ],
        "properties": {
          "event_type": {
            "enum": [
              "connection_open",
              "auth_failure",
              "auth_success",
              "file_operation",
              "synthetic_file_access",
              "bait_served",
              "connection_close"
            ]
          },
          "attributes": {
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "const": "smb"
              },
              "password_sha256": false,
              "ingress": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "db_request"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "attributes"
        ],
        "properties": {
          "sensor_id": {
            "const": "db-decoy-01"
          },
          "attributes": {
            "required": [
              "db"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "file_operation"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "attributes"
        ],
        "properties": {
          "sensor_id": {
            "const": "file-decoy-01"
          },
          "attributes": {
            "required": [
              "file"
            ]
          }
        }
      }
    },
    {
      "description": "Authentication on a challenge-response decoy carries a credential proof record instead of a password hash.",
      "if": {
        "properties": {
          "sensor_id": {
            "enum": [
              "db-decoy-01",
              "file-decoy-01"
            ]
          },
          "event_type": {
            "enum": [
              "auth_failure",
              "auth_success"
            ]
          }
        },
        "required": [
          "sensor_id",
          "event_type"
        ]
      },
      "then": {
        "required": [
          "attributes"
        ],
        "properties": {
          "attributes": {
            "required": [
              "credential"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "attributes_v1_0": {
      "description": "Frozen copy of the 1.0 attribute rules (contracts/history/event.schema.v1.0.json). Do not tighten.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "username": { "type": "string", "maxLength": 128 },
        "password_sha256": { "type": "string" },
        "client_version": { "type": "string", "maxLength": 256 },
        "command": { "type": "string", "maxLength": 4096 },
        "method": { "type": "string" },
        "path": { "type": "string", "maxLength": 4096 },
        "query_redacted": { "type": "string", "maxLength": 4096 },
        "user_agent": { "type": "string", "maxLength": 512 },
        "status_code": { "type": "integer" },
        "response_class": { "enum": ["normal", "fake_error", "fake_data", "blocked"] },
        "honeytoken_id": { "type": "string" },
        "asset_id": { "type": "string" },
        "size_bytes": { "type": "integer" },
        "sha256": { "type": "string" },
        "outcome": { "enum": ["served", "denied", "not_found"] },
        "block_action_id": { "type": "string" }
      }
    },
    "attributes_v1_1": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "username": { "type": "string", "maxLength": 128 },
        "password_sha256": { "type": "string", "maxLength": 128, "description": "Never the raw password" },
        "client_version": { "type": "string", "maxLength": 256, "description": "Client-claimed banner. A claim, not identity." },
        "command": { "type": "string", "maxLength": 4096 },
        "method": { "type": "string", "maxLength": 16 },
        "path": { "type": "string", "maxLength": 4096 },
        "query_redacted": { "type": "string", "maxLength": 4096, "description": "Query string with any honeytoken or password values replaced by <redacted>" },
        "user_agent": { "type": "string", "maxLength": 512, "description": "Client-claimed. A claim, not identity." },
        "status_code": { "type": "integer" },
        "response_class": { "enum": ["normal", "fake_error", "fake_data", "blocked"] },
        "honeytoken_id": { "type": "string", "maxLength": 128, "description": "A honeytoken PRESENTED by the client (login, query). Served bait uses honeytoken_ids." },
        "asset_id": { "type": "string", "maxLength": 128, "description": "Registered synthetic object id, e.g. 'ssh:/home/dg_demo/notes.txt', 'web:/.env', 'customer_data.csv'." },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "maxLength": 64, "description": "Digest of the content named by digest_scope." },
        "outcome": {
          "enum": ["served", "denied", "not_found", "attempted", "emulated_success", "failed", "unknown"],
          "description": "1.0 values keep their meaning ('served' = emulated_success for a synthetic file)."
        },
        "block_action_id": { "type": "string", "maxLength": 64 },
        "policy_revision": { "type": "integer", "minimum": 0, "description": "blocked_request: revision of the policy snapshot that denied it (M2)." },
        "observation_kind": {
          "enum": ["network_input", "command_input", "emulated_result", "policy_result"],
          "description": "What the record observed. If absent the backend derives it from event_type (API.md)."
        },
        "evidence_role": { "enum": ["request", "result", "bait"] },
        "request_id": { "type": "string", "maxLength": 64, "description": "Web: one id per HTTP request; every record about that request carries it." },
        "honeytoken_ids": {
          "type": "array", "items": { "type": "string", "maxLength": 128 },
          "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "description": "bait_served (and command_input with requested_asset_id): tokens contained in the asset. Ids only, never values."
        },
        "issuance_id": { "type": "string", "maxLength": 64, "description": "bait_served: unique per serving. With a static credential several issuances carry the same token; the backend then keeps the attribution ambiguous." },
        "issued_expires_at": { "type": ["string", "null"], "format": "date-time", "description": "bait_served: optional expiry; null = valid until the run ends." },
        "evidence_basis": {
          "enum": ["sensor_response", "session_output_log"],
          "description": "bait_served: what shows the content was actually returned. sensor_response = the decoy logged sending the response (web). session_output_log = the sensor's own recorded output stream for the session contains the bait (e.g. a Cowrie TTY log). A command alone is never enough; see requested_asset_id."
        },
        "requested_asset_id": { "type": "string", "maxLength": 128, "description": "command_input: the adapter recognised a read of this registered bait asset (e.g. 'cat notes.txt'). A request, not proof the content was returned." },
        "fixture_version": { "type": "string", "maxLength": 32, "description": "Version label of the synthetic asset, a string such as 'env@1'." },
        "digest_scope": { "enum": ["full_response", "full_sanitised_response", "full_asset", "partial"], "description": "What sha256 covers. 'partial' digests must never be presented as whole-content proof." },
        "input_features": { "$ref": "#/$defs/input_features" },
        "processing": { "$ref": "#/$defs/processing" }
      }
    },
    "attributes_v1_2": {
      "description": "1.2 = every 1.1 attribute rule plus the fields below. Unknown keys still pass (bounded by the backend), except that no key may claim a malware verdict.",
      "allOf": [
        {
          "$ref": "#/$defs/attributes_v1_1"
        },
        {
          "description": "honeytoken_id on a challenge-response login only when the decoy verified the proof against a planted credential.",
          "if": {
            "required": [
              "credential"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "credential": {
                  "properties": {
                    "proof_check": {
                      "const": "matched_honeytoken"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "honeytoken_id"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "honeytoken_id"
                ]
              }
            }
          }
        },
        {
          "description": "Only a verified gateway context may name a gateway request or session.",
          "if": {
            "required": [
              "ingress"
            ],
            "properties": {
              "ingress": {
                "properties": {
                  "gateway_context": {
                    "enum": [
                      "absent",
                      "invalid"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "ingress": {
                "properties": {
                  "gateway_request_id": false,
                  "gateway_session_ref": false
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "ingress"
            ],
            "properties": {
              "ingress": {
                "properties": {
                  "gateway_context": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "ingress": {
                "required": [
                  "gateway_request_id"
                ]
              }
            }
          }
        }
      ],
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "(?i)(verdict|malware|malicious)"
        }
      },
      "properties": {
        "protocol": {
          "enum": [
            "ssh",
            "http",
            "mysql",
            "smb"
          ],
          "description": "Wire protocol the sensor spoke. Required on db-decoy-01 and file-decoy-01."
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        },
        "credential": {
          "$ref": "#/$defs/credential"
        },
        "db": {
          "$ref": "#/$defs/db_request"
        },
        "file": {
          "$ref": "#/$defs/file_operation"
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "transfer": {
          "$ref": "#/$defs/transfer"
        }
      }
    },
    "ingress": {
      "description": "1.2, web-decoy-01 only: how the request reached the decoy. Set by the decoy from its own check of the gateway's signed context header (API.md, Gateway trust boundary). A client header can never set these fields. 'verified': src_ip is the client address from the signed context. 'absent' (direct 8080 traffic) and 'invalid' (a context that failed verification): src_ip is the TCP peer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_context"
      ],
      "properties": {
        "gateway_context": {
          "enum": [
            "verified",
            "absent",
            "invalid"
          ]
        },
        "gateway_request_id": {
          "type": "string",
          "pattern": "^gw_[A-Za-z0-9_-]{8,64}$"
        },
        "gateway_session_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^gws_[0-9a-f]{16,64}$"
        },
        "invalid_reason": {
          "enum": [
            "bad_signature",
            "expired",
            "wrong_run",
            "wrong_upstream",
            "malformed"
          ],
          "description": "Only with gateway_context 'invalid'."
        }
      }
    },
    "credential": {
      "description": "1.2: what a challenge-response decoy can truthfully say about a presented credential. MySQL and NTLM send a salted proof, never the password, so there is no password hash and no cross-attempt password fingerprint. The decoy can only check the proof against planted lab credentials it was configured with.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "proof_check"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "mysql_native_password",
            "caching_sha2_password",
            "ntlmv2",
            "ntlmv1",
            "smb_anonymous",
            "smb_guest",
            "other"
          ]
        },
        "proof_check": {
          "enum": [
            "matched_honeytoken",
            "not_matched",
            "not_checked",
            "unsupported_scheme",
            "malformed"
          ],
          "description": "matched_honeytoken: the proof verifies against a planted credential (honeytoken_id names it). not_matched: checked against every planted credential for that user, none verified. not_checked / unsupported_scheme / malformed: nothing is known about the password."
        },
        "verifier_version": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "db_request": {
      "description": "1.2, db_request: a MySQL command packet received by the emulator. The emulator does not execute queries; execution is always 'not_supported'. Metadata only: no statement text.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "execution"
      ],
      "properties": {
        "command": {
          "enum": [
            "COM_QUERY",
            "COM_INIT_DB",
            "COM_PING",
            "COM_QUIT",
            "COM_FIELD_LIST",
            "COM_STMT_PREPARE",
            "COM_STMT_EXECUTE",
            "other"
          ]
        },
        "statement_verb": {
          "enum": [
            "select",
            "show",
            "insert",
            "update",
            "delete",
            "drop",
            "create",
            "use",
            "set",
            "load",
            "other",
            "none"
          ]
        },
        "length_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "schema_name": {
          "type": "string",
          "maxLength": 64
        },
        "execution": {
          "const": "not_supported"
        },
        "error_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "file_operation": {
      "description": "1.2, file_operation: one SMB/file-service operation as the emulator handled it. Uploaded content is stored inert for review or discarded; it is never executed, opened by a parser, or scanned into a verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "share"
      ],
      "properties": {
        "operation": {
          "enum": [
            "tree_connect",
            "list",
            "open",
            "read",
            "write",
            "create",
            "delete",
            "rename",
            "close"
          ]
        },
        "share": {
          "type": "string",
          "maxLength": 80
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest_scope": {
          "enum": [
            "full_content",
            "partial",
            "none"
          ],
          "description": "full_content only when every byte written was hashed."
        },
        "storage": {
          "enum": [
            "quarantined_inert",
            "discarded",
            "not_applicable"
          ]
        },
        "magic_type_hint": {
          "enum": [
            "text",
            "csv",
            "zip",
            "pe",
            "elf",
            "script",
            "office",
            "pdf",
            "unknown"
          ],
          "description": "From the first bytes only. A file-type hint, not a verdict."
        }
      }
    },
    "archive": {
      "description": "1.2, on bait_served / synthetic_file_access of an archive lure (for example web:/backup/backup.zip): the fixed, inert contents. Plain-text and CSV entries only; no executable, script, shortcut or auto-run entry, no nested archive, no path components.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "entries",
        "contains_executable",
        "auto_run"
      ],
      "properties": {
        "format": {
          "const": "zip"
        },
        "compression": {
          "enum": [
            "stored",
            "deflate"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.(txt|csv)$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "honeytoken_ids": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          }
        },
        "contains_executable": {
          "const": false
        },
        "auto_run": {
          "const": false
        }
      }
    },
    "transfer": {
      "description": "1.2: what the serving sensor observed of its own response. 'body_written' means the server finished writing the body to its socket; it is not evidence the client received, saved, opened or extracted it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion"
      ],
      "properties": {
        "response_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_length": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_written": {
          "type": "integer",
          "minimum": 0
        },
        "completion": {
          "enum": [
            "body_written",
            "aborted",
            "headers_only",
            "unknown"
          ]
        }
      }
    },
    "input_features": {
      "description": "M4. Sanitised, bounded description of client input (query, form or JSON body) without any raw value. Lets the backend classify body payloads without storing them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "field_count", "indicators"],
      "properties": {
        "source": { "enum": ["query", "form", "json", "multipart", "none"] },
        "field_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "field_names": {
          "type": "array", "maxItems": 32,
          "items": { "type": "string", "maxLength": 64 },
          "description": "Names only. Values are never included, sensitive or not."
        },
        "max_value_length": { "type": "integer", "minimum": 0 },
        "indicators": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {
            "enum": ["sql_quote", "sql_keyword", "sql_comment",
                     "sql_quote_breakout", "sql_union_select", "sql_tautology", "sql_stacked_query", "sql_time_function",
                     "script_tag", "event_handler", "js_scheme",
                     "path_traversal", "sensitive_file_path", "php_wrapper", "remote_url_in_param",
                     "shell_metachar_command", "command_substitution", "null_byte", "encoded_payload"]
          },
          "description": "Fixed vocabulary computed by the producer on each decoded value (contracts/API.md, Indicator semantics). sql_quote, sql_keyword, sql_comment, null_byte and encoded_payload are supporting only. The backend owns classification."
        },
        "truncated": { "type": "boolean", "description": "True if feature extraction stopped at a limit." }
      }
    },
    "processing": {
      "description": "M4. How the producer handled the request body, so an absent feature is not mistaken for a clean request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["parse_status"],
      "properties": {
        "parse_status": { "enum": ["parsed", "no_body", "rejected_too_large", "unsupported_type", "malformed"] },
        "body_bytes": { "type": "integer", "minimum": 0, "description": "Bytes received (may exceed what was parsed)." },
        "body_consumed": { "type": "boolean", "description": "True only if the whole body was read; a full digest is valid only then." },
        "redaction_version": { "type": "string", "maxLength": 32 },
        "producer_version": { "type": "string", "maxLength": 32 }
      }
    }
  }
}
